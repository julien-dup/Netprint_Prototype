<?xml version="1.0" encoding="utf-8"?>
<!-- NetPrint : racine du site IIS (remplace le Portail NetPrint). Les autres applications web (ex. /gestionoutils)
     restent des sous-applications IIS avec leur propre pool. -->
<configuration>
  <!-- inheritInChildApplications="false" : les sous-applications n'héritent PAS du module ASP.NET Core de NetPrint -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\NetPrint.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
