@page "/ventes/commandes/{Numero:int}/{Cle?}"
@* =====================================================================
   Fiche d'une commande client (négoce ou produit fini), en lecture seule.
   Reprise de NEG510 (en-tête, menu de la commande) et de FEN_commandes (HistoriqueDossiers) :
   en-tête complet, lignes (détail dépliable), livraisons (BL), factures, journal des lignes (NEG100E),
   historique du dossier (DOS040).
   Une adresse par commande : /ventes/commandes/n° de dossier/clé.
   Prochaines étapes : modification de l'en-tête (DOS505), saisie des lignes (NEG520), solde, ARC.
   ===================================================================== *@
@using static NetPrint.Modules.Ventes.Ecrans.Commandes.AffichageCommandes
@inject IConsultationCommandes Consultation
@inject EtatListeCommandes Etat
@inject NavigationManager Navigation
@inject Notifications Notifications
@inject ISaisieLignesCommande Lignes
@inject ISaisieCommandes Saisie
@inject Dialogues Dialogues
@inject IActionsCommande Actions
@inject IEditionArc Arc
@using NetPrint.Noyau.Evenements

<PageTitle>Commande @CleCourante.Libelle · NetPrint</PageTitle>
<HeadContent><link rel="stylesheet" href="_content/NetPrint.Modules.Ventes/commandes.css" /></HeadContent>

<fieldset class="barre-outils">
    <button @onclick="Retour" title="Retour à la liste des commandes">← Liste des commandes</button>
    <span class="separateur-vertical"></span>
    <button disabled="@(!PeutModifier)" title="@(PeutModifier ? "Modifier l'en-tête de la commande" : RaisonNonModifiable)"
            @onclick='() => Navigation.NavigateTo(Adresse(CleCourante) + "/entete")'>✏️ Modifier l'en-tête</button>
    <button disabled="@(!PeutModifier)" title="@(PeutModifier ? "Ajouter une ligne à la commande" : RaisonNonModifiable)"
            @onclick="() => OuvrirLigneAsync(0)">＋ Ajouter une ligne</button>
    <button disabled="@(fiche is null)" title="Lancement en fabrication : OF, stock, affectations (NEG515)"
            @onclick='() => Navigation.NavigateTo(Adresse(CleCourante) + "/lancement")'>🏭 Lancement</button>
    <div class="menu">
        <button type="button" class="@(menuActions ? "ouvert" : "")" disabled="@(fiche is null)" title="Autres actions sur la commande"
                @onclick="() => menuActions = !menuActions">⋯ Plus</button>
        @if (menuActions && fiche is not null)
        {
            <div class="fond-menu" @onclick="() => menuActions = false"></div>
            <ul class="menu-contextuel menu-deroulant">
                @Action("📄 Ligne d'après un devis", PeutModifier, PeutModifier ? "Nouvelle ligne reprise d'un devis du client (F10 de NEG520)" : RaisonNonModifiable,
                    () => repriseDevis = true)
                @Action("📅 Reporter des dates", PeutModifier, PeutModifier ? "Reporter la date de livraison de plusieurs lignes (F19 de NEG520)" : RaisonNonModifiable,
                    () => reportDates = true)
                @Action("🧾 Facturation automatique", true, "Paramètres de facturation automatique (F13 de DOS505)", () => facturationAuto = true)
                <li class="separateur"></li>
                @if (fiche.Entete.Soldee)
                {
                    @Action("↺ Réactiver la commande", fiche.Droits.Creer && !fiche.Entete.NonModifiable,
                        "Remettre la commande en cours (ses lignes soldées le restent)", ReactiverCommandeAsync)
                }
                else
                {
                    @Action("✔ Solder la commande", fiche.Droits.Creer && !fiche.Entete.NonModifiable, "Solder toutes les lignes et la commande",
                        SolderCommandeAsync)
                }
                @Action("🗑 Supprimer la commande", fiche.Droits.Supprimer && !fiche.Entete.NonModifiable,
                    "Supprimer la commande (impossible si elle a un BL ou une facture)", SupprimerCommandeAsync, danger: true)
            </ul>
        }
    </div>
    <span class="espace"></span>
    <button class="@(apercuArc ? "actif" : "")" disabled="@(fiche is null)" title="Aperçu de l'accusé de réception, mis à jour à chaque modification"
            @onclick="() => apercuArc = !apercuArc">👁 Aperçu ARC</button>
    <button disabled="@(fiche is null || !fiche.Droits.Editer)" title="@(fiche is { Droits.Editer: false } ? "Vous n'êtes pas autorisé à éditer les commandes" : "Accusé de réception : PDF ou message Outlook")"
            @onclick="OuvrirEditionArc">🖨 ARC</button>
</fieldset>

<div class="@(apercuArc && fiche is not null ? "fiche-avec-apercu" : "")">
<div class="contenu contenu-detail fiche-commande">
    @if (chargement)
    {
        <p class="compteur"><span class="chargement">Chargement de la commande…</span></p>
    }
    else if (fiche is null)
    {
        <div class="carte carte-message">
            <p>La commande @CleCourante.Libelle n'existe pas ou ne vous est pas accessible.</p>
            <p><button @onclick="Retour">← Liste des commandes</button></p>
        </div>
    }
    else
    {
        var e = fiche.Entete;
        <section class="entete-commande">
            <div class="titre-panneau">
                <span class="sur-titre">Commande @TypesCommande.Libelle(e.TypeCommande).ToLowerInvariant()</span>
                <span class="code-titre">@e.Cle.Libelle</span>
                <span class="badge badge-etat etat-@Classe(e.Etat)">@Libelle(e.Etat)@(e.DateSolde is { } ds ? $" le {ds:dd/MM/yyyy}" : "")</span>
                @if (e.NonModifiable)
                {
                    <span class="badge badge-alerte" title="Commande sous-traitée : elle ne peut plus être modifiée (CCOP11, NEG510 R3)">Non modifiable</span>
                }
                @if (e.SousTraitee)
                {
                    <span class="badge badge-appel" title="Commande sous-traitée à un autre site (CCOP10)">Sous-traitée</span>
                }
                <span class="titre-designation">@e.Designation1 @e.Designation2</span>
            </div>

            <div class="indicateurs">
                <div class="indicateur"><span class="valeur-indicateur">@Montant(e.Valeur)</span><span>valeur</span></div>
                <div class="indicateur"><span class="valeur-indicateur">@fiche.Lignes.Count</span><span>ligne@(fiche.Lignes.Count > 1 ? "s" : "")</span></div>
                <div class="indicateur">
                    <span class="valeur-indicateur">@(fiche.TauxLivraison is { } t ? t.ToString("P0") : "—")</span>
                    <span>livré</span>
                    @if (fiche.TauxLivraison is { } taux)
                    {
                        <span class="avancement large"><span class="barre" style="width:@((int)(taux * 100))%"></span></span>
                    }
                </div>
                <div class="indicateur"><span class="valeur-indicateur">@fiche.Livraisons.Count</span><span>BL</span></div>
                <div class="indicateur"><span class="valeur-indicateur">@fiche.Factures.Count</span><span>facture@(fiche.Factures.Count > 1 ? "s" : "")</span></div>
            </div>

            <div class="cartes-entete">
                <div class="carte">
                    <h3>Client</h3>
                    <div><b>@e.NomClient</b> <span class="discret">@e.Client</span>@if (e.Revendeur) {<span class="badge badge-appel">Revendeur</span>}</div>
                    @Info("Facturé à", e.ClientFacture)
                    @Info("Enseigne", e.Enseigne)
                    @Info("Interlocuteur", e.Interlocuteur)
                </div>
                <div class="carte">
                    <h3>Commande</h3>
                    @Info("Réf. client", e.ReferenceCommandeClient)
                    @Info("Du", Date(e.DateCommandeClient))
                    @Info("Ouverte le", Date(e.DateOuverture))
                    @Info("Profil", e.Profil)
                </div>
                <div class="carte">
                    <h3>Livraison</h3>
                    @Info("Date", e.SemaineLivraison != "" ? $"semaine {e.SemaineLivraison}" : Date(e.DateLivraison))
                    @Info("Mode", e.Livraison)
                    @Info("Port", e.Port)
                </div>
                <div class="carte">
                    <h3>Commercial</h3>
                    @Info("Représentant", e.Representant)
                    @Info("Commission", e.TauxCommission == 0 ? "" : $"{e.TauxCommission:0.##} %")
                    @Info("Fabricant", e.Fabricant)
                    @Info("Catégorie", $"{e.Categorie} {e.SousCategorie}".Trim())
                    @Info("Code vente", e.CodeVente)
                    @Info("Remise", e.TauxRemise == 0 ? "" : $"{e.TauxRemise} %")
                </div>
                <div class="carte">
                    <h3>Facturation</h3>
                    @Info("Type", e.TypeFacturation)
                    @Info("Règlement", e.Reglement)
                    @Info("Devise", e.Devise)
                    @Info("Adresse ARC", e.AdresseArc == 0 ? "" : $"n° {e.AdresseArc}")
                    @Info("Documents", fiche.NbDocuments > 0 ? $"📎 {fiche.NbDocuments}" : "")
                </div>
            </div>
        </section>

        <nav class="onglets onglets-detail">
            @foreach (var (cle, libelle, nombre) in Onglets)
            {
                <button class="@(cle == onglet ? "actif" : "")" @onclick="() => onglet = cle">
                    @libelle <span class="nombre-onglet">@nombre</span>
                </button>
            }
        </nav>

        <div class="zone-detail">
            @switch (onglet)
            {
                case "lignes":
                    @TableLignes
                    break;
                case "livraisons":
                    @TableLivraisons
                    break;
                case "factures":
                    @TableFactures
                    break;
                case "journal":
                    @TableJournal
                    break;
                case "envois":
                    @TableEnvois
                    break;
                case "evenements":
                    <Evenements Objet="ObjetEvenements.DeCommande(CleCourante.Numero, CleCourante.Cle)" Modifiable="fiche.Droits.Modifier" OnNombre="n => nbEvenements = n" />
                    break;
                default:
                    @TableHistorique
                    break;
            }
        </div>
    }
</div>

@if (apercuArc && fiche is not null)
{
    <aside class="panneau-apercu">
        <div class="titre-apercu">
            <b>Aperçu de l'ARC</b>
            <label class="champ-case"><input type="checkbox" @bind="apercuSoldees" /> <span>Lignes soldées</span></label>
            <a href="@AdresseArc(apercuSoldees, apercu: true)" target="_blank" rel="noopener" title="Ouvrir l'aperçu dans un onglet">↗</a>
            <button type="button" class="bouton-icone" title="Fermer l'aperçu" @onclick="() => apercuArc = false">✕</button>
        </div>
        <iframe src="@AdresseArc(apercuSoldees, apercu: true)" title="Aperçu de l'ARC"></iframe>
    </aside>
}
</div>

@if (editionArc && fiche is not null)
{
    <FenetreArc Commandes="[new(CleCourante, fiche.Entete.Designation1)]" Client="@fiche.Entete.NomClient" OnFermer="FermerEditionArcAsync" />
}

@if (ligneOuverte is { } numeroLigne && fiche is not null)
{
    <FenetreLigne Commande="CleCourante" NumeroLigne="numeroLigne" LigneOrigine="origineAppel" Initiale="ligneInitiale" CodesVente="codesVente"
                  ClientArticles="@fiche.Entete.Client"
                  OnFermer="FermerLigneAsync" />
}
@if (facturationAuto && fiche is not null)
{
    <FenetreFacturationAuto Commande="CleCourante" Modifiable="PeutModifier" OnFermer="() => facturationAuto = false" />
}
@if (reportDates && fiche is not null)
{
    <FenetreReportDates Commande="CleCourante" OnFermer="FermerReportDatesAsync" />
}
@if (repriseDevis && fiche is not null)
{
    <FenetreRepriseDevis Commande="CleCourante" OnFermer="FermerRepriseDevisAsync" />
}

@code {
    [Parameter] public int Numero { get; set; }
    [Parameter] public string? Cle { get; set; }

    private CleCommande CleCourante => new(Numero, (Cle ?? "").Trim().ToUpperInvariant());

    private FicheCommande? fiche;
    private bool chargement = true;
    private string onglet = "lignes";
    private int? nbEvenements;   // connu une fois l'onglet ouvert (EVE300)
    private readonly HashSet<int> lignesOuvertes = [];

    // Passage d'une commande à une autre : seule la dernière lecture demandée est affichée
    private int lecture;

    protected override Task OnParametersSetAsync() => ChargerAsync();

    private async Task ChargerAsync()
    {
        var cle = CleCourante;
        var numeroLecture = ++lecture;
        chargement = true;
        lignesOuvertes.Clear();
        FicheCommande? lue = null;
        try
        {
            lue = await Consultation.LireAsync(cle);
        }
        catch (Exception ex)
        {
            if (numeroLecture == lecture) Notifications.Erreur($"Lecture de la commande impossible : {ex.Message}");
        }
        if (numeroLecture != lecture) return;
        fiche = lue;
        if (fiche is not null) Etat.Selection = cle;
        versionArc++;
        envois = null;
        nbEvenements = null;
        if (fiche is not null) await ChargerEnvoisAsync();
        chargement = false;
    }

    private void Retour() => Navigation.NavigateTo("ventes/commandes");

    // ---------- ARC (ARC105P) : édition en PDF, aperçu à côté de la fiche ----------
    private bool apercuArc;
    private bool apercuSoldees = true;
    private bool editionArc;
    private int versionArc;   // change à chaque rechargement de la fiche : l'aperçu est recalculé

    private string AdresseArc(bool soldees, bool apercu) =>
        $"api/ventes/commandes/{CleCourante.Numero}/{CleCourante.Cle}/arc?soldees={(soldees ? "O" : "N")}" +
        (apercu ? $"&apercu=1&v={versionArc}" : "");

    private void OuvrirEditionArc() => editionArc = true;

    private async Task FermerEditionArcAsync()
    {
        editionArc = false;
        await ChargerEnvoisAsync();   // un envoi vient peut-être d'être tracé
    }

    // ---------- Journal des envois de l'ARC (ENV100), lu avec la fiche ----------
    private IReadOnlyList<EnvoiArcTrace>? envois;
    private string? erreurEnvois;

    private async Task ChargerEnvoisAsync()
    {
        erreurEnvois = null;
        try { envois = await Arc.LireEnvoisAsync(CleCourante); }
        catch (Exception ex)
        {
            envois = [];
            erreurEnvois = $"Lecture des envois impossible : {ex.Message}";
        }
    }

    private RenderFragment TableEnvois => __builder =>
    {
        if (envois is null)
        {
            <p class="chargement">Chargement…</p>
            return;
        }
        if (erreurEnvois is not null)
        {
            <p class="erreur-saisie">@erreurEnvois <button type="button" class="bouton-lien" @onclick="ChargerEnvoisAsync">Réessayer</button></p>
            return;
        }
        <table class="grille grille-fiche">
            <thead><tr><th>Date</th><th>Canal</th><th>État</th><th>Par</th><th>À</th><th>Copie</th><th>Objet</th><th>PDF</th></tr></thead>
            <tbody>
                @foreach (var e in envois)
                {
                    <tr>
                        <td>@e.Date.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@e.Canal</td>
                        <td>
                            <span class="badge badge-etat @(e.Statut switch { "Envoyé" => "etat-livree", "Échec" => "etat-annulee", _ => "etat-partielle" })"
                                  title="@(e.Erreur != "" ? e.Erreur : e.Redirection != "" ? $"Redirigé vers {e.Redirection}" : "")">@e.Statut</span>
                        </td>
                        <td>@e.Profil <span class="discret">@e.Expediteur</span></td>
                        <td>@e.Destinataires</td>
                        <td>@e.Copies</td>
                        <td>@e.Objet</td>
                        <td>@if (e.AvecPdf) {<a href="@($"api/ventes/commandes/{CleCourante.Numero}/{CleCourante.Cle}/envois/{e.Id}/pdf")" target="_blank" rel="noopener">📄</a>}</td>
                    </tr>
                }
                @if (envois.Count == 0)
                {
                    <tr class="ligne-vide"><td colspan="8">Aucun envoi d'ARC tracé pour cette commande.</td></tr>
                }
            </tbody>
        </table>
    };

    // ---------- Actions sur la commande (DOS500S) ----------
    private Task SolderCommandeAsync() => ActionCommandeAsync(
        "Solder la commande : toutes ses lignes seront soldées. Continuer ?", "Solder la commande", () => Actions.SolderAsync(CleCourante), "soldée");

    private Task ReactiverCommandeAsync() => ActionCommandeAsync(
        "Remettre la commande en cours ? Ses lignes soldées le restent.", "Réactiver la commande", () => Actions.ReactiverAsync(CleCourante), "réactivée");

    private async Task SupprimerCommandeAsync()
    {
        if (await ActionCommandeAsync($"Supprimer définitivement la commande {CleCourante.Libelle} et ses lignes ?", "Supprimer la commande",
                () => Actions.SupprimerAsync(CleCourante), "supprimée", recharger: false))
        {
            // La commande disparaît de la liste conservée en session
            if (Etat.Resultat is { } r)
                Etat.Resultat = r with { Commandes = r.Commandes.Where(c => c.Cle != CleCourante).ToList() };
            Etat.Selection = null;
            Retour();
        }
    }

    private async Task<bool> ActionCommandeAsync(string question, string titre, Func<Task> action, string participe, bool recharger = true)
    {
        if (!await Dialogues.ConfirmerAsync(question, titre, "Confirmer")) return false;
        try
        {
            await action();
            Notifications.Succes($"Commande {CleCourante.Libelle} {participe}.");
            if (recharger) await ChargerAsync();
            return true;
        }
        catch (RegleMetierException ex)
        {
            await Dialogues.AlerterAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Notifications.Erreur($"{titre} impossible : {ex.Message}");
        }
        return false;
    }

    // ---------- Lignes (NEG520) ----------
    private int? ligneOuverte;
    private int origineAppel;
    private IReadOnlyList<CodeLibelle> codesVente = [];

    // Nouvel appel de livraison sur une ligne « à la demande »
    private Task OuvrirAppelAsync(int origine) => OuvrirLigneAsync(0, origine);

    private bool facturationAuto;
    private bool menuActions;

    // Entrée du menu « Plus » : grisée avec sa raison si l'action n'est pas permise ; le menu se ferme au choix
    private RenderFragment Action(string libelle, bool permise, string titre, Action action, bool danger = false) =>
        Action(libelle, permise, titre, () => { action(); return Task.CompletedTask; }, danger);

    private RenderFragment Action(string libelle, bool permise, string titre, Func<Task> action, bool danger = false) => __builder =>
    {
        <li class="@(!permise ? "inactif" : danger ? "danger" : "")" title="@titre"
            @onclick="async () => { if (!permise) return; menuActions = false; await action(); }">@libelle</li>
    };

    // Report de dates en masse : la fiche est relue après un report
    private bool reportDates;

    private async Task FermerReportDatesAsync(bool reporte)
    {
        reportDates = false;
        if (reporte) await ChargerAsync();
    }

    // Ligne d'après un devis : la ligne pré-remplie s'ouvre comme une nouvelle ligne
    private bool repriseDevis;
    private LigneSaisie? ligneInitiale;

    private async Task FermerRepriseDevisAsync(LigneSaisie? ligne)
    {
        repriseDevis = false;
        if (ligne is not null) await OuvrirLigneAsync(0, initiale: ligne);
    }

    private async Task OuvrirLigneAsync(int numero, int origine = 0, LigneSaisie? initiale = null)
    {
        origineAppel = origine;
        ligneInitiale = initiale;
        if (codesVente.Count == 0)
        {
            try { codesVente = (await Saisie.LireContexteAsync()).CodesVente; }
            catch (Exception ex) { Notifications.Erreur($"Lecture des codes vente impossible : {ex.Message}"); return; }
        }
        ligneOuverte = numero;
    }

    private async Task FermerLigneAsync(int? numero)
    {
        ligneOuverte = null;
        if (numero is { } n)
        {
            await ChargerAsync();
            lignesOuvertes.Add(n);
        }
    }

    private Task SolderLigneAsync(LigneCommandeListe l) => OptionLigneAsync(l, "Solder la ligne", () => Lignes.SolderAsync(CleCourante, l.NumeroLigne), "soldée");
    private Task ReactiverLigneAsync(LigneCommandeListe l) => OptionLigneAsync(l, "Réactiver la ligne", () => Lignes.ReactiverAsync(CleCourante, l.NumeroLigne), "réactivée");
    private Task SupprimerLigneAsync(LigneCommandeListe l) => OptionLigneAsync(l, "Supprimer la ligne", () => Lignes.SupprimerAsync(CleCourante, l.NumeroLigne), "supprimée");

    // Options de la liste (NEG52004 / 05 / 06) : confirmation, action, rechargement de la fiche
    private async Task OptionLigneAsync(LigneCommandeListe l, string titre, Func<Task> action, string participe)
    {
        if (!await Dialogues.ConfirmerAsync($"{titre} {l.NumeroLigne} ({ArticleIndice(l)}, {l.Designation}) ?", titre, "Confirmer")) return;
        try
        {
            await action();
            Notifications.Succes($"Ligne {l.NumeroLigne} {participe}.");
            await ChargerAsync();
        }
        catch (RegleMetierException ex)
        {
            await Dialogues.AlerterAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Notifications.Erreur($"{titre} impossible : {ex.Message}");
        }
    }

    // Modification de l'en-tête : droit DOS500C, commande ni soldée ni sous-traitée (NEG510 R3)
    private bool PeutModifier => fiche is { Entete.Soldee: false, Entete.NonModifiable: false, Droits.Modifier: true };

    private string RaisonNonModifiable => fiche is null ? ""
        : fiche.Entete.Soldee ? "Commande soldée"
        : fiche.Entete.NonModifiable ? "Commande sous-traitée : modification impossible"
        : "Vous n'êtes pas autorisé à modifier les commandes";



    private IEnumerable<(string Cle, string Libelle, int? Nombre)> Onglets =>
    [
        ("lignes", "Lignes", fiche!.Lignes.Count),
        ("livraisons", "Livraisons", fiche.Livraisons.Count),
        ("factures", "Factures", fiche.Factures.Count),
        ("journal", "Journal des lignes", fiche.Journal.Count),
        ("envois", "Envois ARC", erreurEnvois is null ? envois?.Count ?? 0 : 0),
        ("evenements", "Événements", nbEvenements),
        ("historique", "Historique", fiche.Historique.Count),
    ];


    private void BasculerLigne(int n)
    {
        if (!lignesOuvertes.Remove(n)) lignesOuvertes.Add(n);
    }

    // ---------- Onglets ----------
    private RenderFragment TableLignes => __builder =>
    {
        <table class="grille grille-fiche">
            <thead>
                <tr>
                    <th class="col-chevron"></th>
                    <th class="nombre">L.</th><th>Article</th><th>Désignation</th><th>Statut</th><th>Livraison</th>
                    <th class="nombre">Quantité</th><th class="nombre">Livrée</th><th class="nombre">Facturée</th><th class="nombre">Reste</th>
                    <th class="nombre">Prix</th><th class="centre">UV</th><th class="nombre">Valeur</th><th>Adresse de livraison</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lf in fiche!.Lignes)
                {
                    var l = lf.Ligne;
                    var ouverte = lignesOuvertes.Contains(l.NumeroLigne);
                    <tr class="@(l.Soldee ? "ligne-soldee" : "")" @onclick="() => BasculerLigne(l.NumeroLigne)">
                        <td class="col-chevron"><button type="button" class="chevron @(ouverte ? "ouvert" : "")" title="Détail de la ligne">▸</button></td>
                        <td class="nombre">@l.NumeroLigne</td>
                        <td><b>@ArticleIndice(l)</b>@if (l.ReferenceImprime != "") {<span class="discret"> · @l.ReferenceImprime</span>}</td>
                        <td title="@BulleLigne(l)">@l.Designation</td>
                        <td>
                            @if (l.ALaDemande) { <span class="badge badge-demande">À la demande</span> }
                            else if (l.EstAppel) { <span class="badge badge-appel" title="Appel de la ligne @lf.LigneOrigine">Appel @l.NumeroAppel</span> }
                            @if (l.Soldee) { <span class="badge badge-etat etat-soldee">Soldée</span> }
                        </td>
                        <td>@(l.ALaDemande ? "" : Date(l.DateLivraison))@if (lf.DateConfirmee is { } dc && dc != l.DateLivraison) {<span class="discret" title="Date confirmée"> → @Date(dc)</span>}</td>
                        <td class="nombre">@Entier(l.Quantite)</td>
                        <td class="nombre">@Entier(l.QuantiteLivree)</td>
                        <td class="nombre">@Entier(l.QuantiteFacturee)</td>
                        <td class="nombre">@Entier(l.ResteALivrer)</td>
                        <td class="nombre">@l.Prix</td>
                        <td class="centre">@l.Unite</td>
                        <td class="nombre"><b>@Montant(l.Valeur)</b></td>
                        <td title="@lf.AdresseLivraison">@lf.AdresseLivraison</td>
                    </tr>
                    @if (ouverte)
                    {
                        <tr class="detail-ligne">
                            <td></td>
                            <td colspan="13">
                                <div class="champs-detail">
                                    @Info("Texte", l.Texte)
                                    @Info("Commentaires", lf.Commentaires)
                                    @Info("N° d'appel", l.NumeroAppel)
                                    @Info("Ligne d'origine", lf.LigneOrigine == 0 ? "" : lf.LigneOrigine.ToString())
                                    @Info("Qté appelée", Entier(lf.QuantiteAppelee))
                                    @Info("Maxi livrable", Entier(lf.MaxiLivrable))
                                    @Info("Prix de cession", Montant(lf.PrixCession))
                                    @Info("Commission", lf.TauxCommission == 0 ? "" : $"{lf.TauxCommission:0.##} %")
                                    @Info("Remise", lf.TauxRemise == 0 ? "" : $"{lf.TauxRemise} %")
                                    @Info("Devis", lf.Devis)
                                    @Info("Facturé à", lf.ClientFacture)
                                    @Info("Norme", l.Norme)
                                    @Info("N° produit", l.Produit == 0 ? "" : l.Produit.ToString())
                                    @Info("Catégorie", $"{l.Categorie} {l.SousCategorie}".Trim())
                                    @Info("Emplacement", lf.Emplacement)
                                    @Info("Commentaires (évts)", l.NbCommentaires == 0 ? "" : l.NbCommentaires.ToString())
                                </div>
                                @if (PeutModifier)
                                {
                                    <div class="actions-ligne">
                                        @if (l.ALaDemande)
                                        {
                                            <button type="button" title="Créer un appel de livraison sur cette ligne (option DE)"
                                                    @onclick="() => OuvrirAppelAsync(l.NumeroLigne)" @onclick:stopPropagation="true">📦 Nouvel appel</button>
                                        }
                                        @if (!l.Soldee)
                                        {
                                            <button type="button" @onclick="() => OuvrirLigneAsync(l.NumeroLigne)" @onclick:stopPropagation="true">✏️ Modifier</button>
                                            <button type="button" @onclick="() => SolderLigneAsync(l)" @onclick:stopPropagation="true">✔ Solder</button>
                                        }
                                        <button type="button" class="bouton-danger" @onclick="() => SupprimerLigneAsync(l)" @onclick:stopPropagation="true">🗑 Supprimer</button>
                                    </div>
                                }
                                @if (l.Soldee && fiche.Droits.Modifier && !fiche.Entete.NonModifiable)
                                {
                                    <div class="actions-ligne">
                                        <button type="button" @onclick="() => ReactiverLigneAsync(l)" @onclick:stopPropagation="true">↺ Réactiver</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                @if (fiche.Lignes.Count == 0)
                {
                    <tr class="ligne-vide"><td colspan="14">Cette commande n'a pas encore de ligne.</td></tr>
                }
            </tbody>
            @if (fiche.Lignes.Count > 1)
            {
                <tfoot>
                    <tr class="ligne-total">
                        <td colspan="6">Total</td>
                        <td class="nombre">@Entier(fiche.Lignes.Sum(l => l.Ligne.Quantite))</td>
                        <td class="nombre">@Entier(fiche.Lignes.Sum(l => l.Ligne.QuantiteLivree))</td>
                        <td class="nombre">@Entier(fiche.Lignes.Sum(l => l.Ligne.QuantiteFacturee))</td>
                        <td class="nombre">@Entier(fiche.Lignes.Sum(l => l.Ligne.ResteALivrer))</td>
                        <td colspan="2"></td>
                        <td class="nombre">@Montant(fiche.Entete.Valeur)</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    };

    private RenderFragment TableLivraisons => __builder =>
    {
        if (fiche!.Livraisons.Count == 0)
        {
            <p class="aide">Aucun bon de livraison pour cette commande.</p>
            return;
        }
        <div class="liste-bl">
            @foreach (var bl in fiche.Livraisons)
            {
                <div class="carte carte-bl">
                    <div class="titre-bl">
                        <b>BL @bl.BonLivraison</b>
                        <span>@(bl.DateExpedition is { } d ? $"expédié le {d:dd/MM/yyyy}" : "non expédié")</span>
                        @if (bl.Facture)
                        {
                            <span class="badge badge-etat etat-livree">Facturé@(bl.NumeroFacture != 0 ? $" n° {bl.NumeroFacture}" : "")@(bl.DateFacture is { } df ? $" le {df:dd/MM/yyyy}" : "")</span>
                        }
                        else
                        {
                            <span class="badge badge-etat etat-partielle">À facturer</span>
                        }
                        <span class="discret">@bl.Adresse</span>
                    </div>
                    <table class="grille grille-compacte">
                        <thead><tr><th class="nombre">L. cde</th><th>Article</th><th>Désignation</th><th class="nombre">Quantité</th></tr></thead>
                        <tbody>
                            @foreach (var l in bl.Lignes)
                            {
                                <tr><td class="nombre">@l.LigneCommande</td><td>@l.Article</td><td>@l.Designation</td><td class="nombre">@Entier(l.Quantite)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    };

    private RenderFragment TableFactures => __builder =>
    {
        <table class="grille grille-fiche grille-etroite">
            <thead><tr><th class="nombre">N° facture</th><th>Date</th><th class="nombre">Quantité</th><th class="nombre">Montant HT</th></tr></thead>
            <tbody>
                @foreach (var f in fiche!.Factures)
                {
                    <tr><td class="nombre">@f.Numero</td><td>@Date(f.Date)</td><td class="nombre">@Entier(f.Quantite)</td><td class="nombre">@Montant(f.Montant)</td></tr>
                }
                @if (fiche.Factures.Count == 0)
                {
                    <tr class="ligne-vide"><td colspan="4">Aucune facture pour cette commande.</td></tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment TableJournal => __builder =>
    {
        if (fiche!.JournalTronque)
        {
            <p class="aide">Seuls les mouvements les plus récents sont affichés.</p>
        }
        <table class="grille grille-fiche">
            <thead>
                <tr><th>Date</th><th>Opération</th><th class="nombre">Ligne</th><th>Profil</th><th>Article</th><th class="nombre">Quantité</th><th class="nombre">Prix</th></tr>
            </thead>
            <tbody>
                @foreach (var j in fiche!.Journal)
                {
                    <tr>
                        <td>@(j.Date?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                        <td><span class="badge badge-journal journal-@j.Type.ToLowerInvariant()">@j.LibelleType</span></td>
                        <td class="nombre">@j.Ligne</td>
                        <td>@j.Profil</td>
                        <td>@Avant(j.AncienArticle, j.Article)</td>
                        <td class="nombre">@Avant(Entier(j.AncienneQuantite), Entier(j.Quantite))</td>
                        <td class="nombre">@Avant(Montant(j.AncienPrix), Montant(j.Prix))</td>
                    </tr>
                }
                @if (fiche.Journal.Count == 0)
                {
                    <tr class="ligne-vide"><td colspan="7">Aucun mouvement enregistré.</td></tr>
                }
            </tbody>
        </table>
    };

    private RenderFragment TableHistorique => __builder =>
    {
        if (fiche!.HistoriqueTronque)
        {
            <p class="aide">Seul l'historique le plus récent est affiché.</p>
        }
        <table class="grille grille-fiche grille-etroite">
            <thead><tr><th>Date</th><th>Type</th><th>Initiales</th></tr></thead>
            <tbody>
                @foreach (var h in fiche!.Historique)
                {
                    <tr><td>@(h.Date?.ToString("dd/MM/yyyy HH:mm") ?? "")</td><td>@TypeHistorique(h.Type)</td><td>@h.Initiales</td></tr>
                }
                @if (fiche.Historique.Count == 0)
                {
                    <tr class="ligne-vide"><td colspan="3">Aucun historique.</td></tr>
                }
            </tbody>
        </table>
    };

    // ---------- Mise en forme ----------
    private static RenderFragment Info(string libelle, string? valeur) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(valeur))
        {
            <div class="info"><span class="libelle-info">@libelle</span> <span class="valeur-info">@valeur</span></div>
        }
    };

    // « ancien → nouveau » quand la valeur a changé (modification), sinon la valeur
    private static RenderFragment Avant(string ancien, string nouveau) => __builder =>
    {
        if (ancien != "" && ancien != nouveau)
        {
            <span class="discret ancien">@ancien</span> <span>→ @nouveau</span>
        }
        else
        {
            @nouveau
        }
    };

    // Types d'historique DOS040 connus par la rétro-doc ; les autres codes sont affichés tels quels
    private static string TypeHistorique(string t) => t switch
    {
        "CR" => "Création",
        "MO" => "Modification",
        "LV" => "Modification des lignes",
        "SO" => "Solde",
        "SU" => "Suppression",
        _ => t,
    };



}
