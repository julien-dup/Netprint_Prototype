@* =====================================================================
   Report de date de livraison en masse (NEG520 F19, fenêtre NEG520CW) : « pour les lignes dont la date (de livraison /
   confirmée) est égale à X, je positionne la date (de livraison / confirmée) au Y ». Lignes soldées ignorées ; refusé si
   une ligne fait partie d'un OPR non livré.
   ===================================================================== *@
@inject IActionsCommande Actions
@inject Notifications Notifications
@inject Dialogues Dialogues

<div class="voile" @onclick="Annuler">
    <form class="fenetre fenetre-report-dates" role="dialog" aria-modal="true" @onclick:stopPropagation="true" @onsubmit="ReporterAsync">
        <div class="titre-fenetre">📅 Reporter des dates · commande @Commande.Libelle</div>
        <div class="corps-fenetre">
            <div class="ligne-champs">
                <label class="champ"><span>Pour les lignes dont la date</span>
                    <select @bind="zoneOrigine">
                        <option value="@ZoneDate.Livraison">de livraison</option>
                        <option value="@ZoneDate.Confirmee">confirmée</option>
                    </select>
                </label>
                <label class="champ @Classe(nameof(ReportDates.DateOrigine))"><span>est égale au</span>
                    <input type="date" @bind="dateOrigine" autofocus />
                </label>
            </div>
            @Message(nameof(ReportDates.DateOrigine))
            <div class="ligne-champs">
                <label class="champ"><span>je positionne la date</span>
                    <select @bind="zoneDestination">
                        <option value="@ZoneDate.Livraison">de livraison</option>
                        <option value="@ZoneDate.Confirmee">confirmée</option>
                    </select>
                </label>
                <label class="champ @Classe(nameof(ReportDates.DateDestination))"><span>au</span>
                    <input type="date" @bind="dateDestination" />
                </label>
            </div>
            @Message(nameof(ReportDates.DateDestination))
            <p class="aide">Les lignes soldées ne changent pas. Le report est refusé si une ligne fait partie d'un ordre de préparation (OPR) non livré.</p>
        </div>
        <div class="pied-fenetre">
            <span class="espace"></span>
            <button type="button" @onclick="Annuler">Annuler</button>
            <button type="submit" class="bouton-principal" disabled="@enCours">Reporter</button>
        </div>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public CleCommande Commande { get; set; } = default!;
    // Vrai si des lignes ont été reportées
    [Parameter] public EventCallback<bool> OnFermer { get; set; }

    private ZoneDate zoneOrigine = ZoneDate.Livraison;
    private ZoneDate zoneDestination = ZoneDate.Livraison;
    private DateOnly? dateOrigine;
    private DateOnly? dateDestination;
    private List<ErreurSaisie> erreurs = [];
    private bool enCours;

    private async Task ReporterAsync()
    {
        if (enCours) return;
        enCours = true;
        erreurs = [];
        try
        {
            var n = await Actions.ReporterDatesAsync(Commande, new ReportDates(zoneOrigine, dateOrigine, zoneDestination, dateDestination));
            if (n == 0)
            {
                await Dialogues.AlerterAsync("Aucune ligne non soldée n'a cette date : rien n'a été reporté.");
                return;
            }
            Notifications.Succes($"{n} ligne{(n > 1 ? "s" : "")} reportée{(n > 1 ? "s" : "")} au {dateDestination:dd/MM/yyyy}.");
            await OnFermer.InvokeAsync(true);
        }
        catch (SaisieInvalideException ex)
        {
            erreurs = [.. ex.Erreurs];
        }
        catch (RegleMetierException ex)
        {
            await Dialogues.AlerterAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Notifications.Erreur($"Report impossible : {ex.Message}");
        }
        finally
        {
            enCours = false;
        }
    }

    private Task Annuler() => OnFermer.InvokeAsync(false);

    private string Classe(string zone) => erreurs.Any(e => e.Zone == zone) ? "en-erreur" : "";

    private RenderFragment Message(string zone) => __builder =>
    {
        foreach (var e in erreurs.Where(e => e.Zone == zone))
        {
            <span class="message-erreur">@e.Message</span>
        }
    };
}
