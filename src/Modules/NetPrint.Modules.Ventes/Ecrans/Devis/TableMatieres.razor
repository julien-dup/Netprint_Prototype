@* Matières (TABLE_Matiere, TABLE_MatiereElt) *@
<table class="grille grille-detail">
    <thead>
        <tr>
            <th>Référence</th>
            <th class="col-libelle">Désignation</th>
            <th class="nombre">Quantité</th>
            <th class="nombre">Prix unitaire</th>
            <th class="nombre">Valeur</th>
            <th class="nombre">Valeur mille +</th>
            @if (AvecCommentaire)
            {
                <th>Commentaire</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Lignes)
        {
            if (l.Nature == NatureLigne.Titre)
            {
                <tr class="ligne-titre"><td colspan="7">@l.Designation</td></tr>
                continue;
            }
            <tr>
                <td>@l.Reference</td>
                <td class="col-libelle">@l.Designation</td>
                <td class="nombre">@Affichage.Nombre(l.Quantite)</td>
                <td class="nombre">@Affichage.Nombre(l.PrixUnitaire)</td>
                <td class="nombre">@Affichage.Montant(l.Valeur)</td>
                <td class="nombre">@Affichage.Montant(l.ValeurMillePlus)</td>
                @if (AvecCommentaire)
                {
                    <td>@l.Commentaire</td>
                }
            </tr>
        }
        @if (Lignes.Count == 0)
        {
            <tr class="ligne-vide"><td colspan="7">Aucune matière.</td></tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LigneMatiere> Lignes { get; set; } = [];
    [Parameter] public bool AvecCommentaire { get; set; }
}
